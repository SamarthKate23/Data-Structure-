
# Case Study 4: Dictionary Application Using Hash Tables
# Collision Resolution: Separate Chaining

class DictionaryHashTable:
    def __init__(self, size=10):
        self.size = size
        self.table = [[] for _ in range(size)]

    # Hash function to calculate the bucket index
    def hash_function(self, word):
        total = 0
        for char in word.lower():
            total += ord(char)
        return total % self.size

    # Add a word and its meaning
    def add_word(self, word, meaning):
        index = self.hash_function(word)

        # Update meaning if the word already exists
        for entry in self.table[index]:
            if entry[0] == word.lower():
                entry[1] = meaning
                print("Meaning updated successfully.")
                return

        # Handle collisions by adding to the bucket list
        if len(self.table[index]) > 0:
            print("Collision detected! Using separate chaining.")

        self.table[index].append([word.lower(), meaning])
        print("Word added successfully.")

    # Search for a word
    def search_word(self, word):
        index = self.hash_function(word)

        for entry in self.table[index]:
            if entry[0] == word.lower():
                print("Meaning:", entry[1])
                return

        print("Word not found.")

    # Delete a word
    def delete_word(self, word):
        index = self.hash_function(word)

        for entry in self.table[index]:
            if entry[0] == word.lower():
                self.table[index].remove(entry)
                print("Word deleted successfully.")
                return

        print("Word not found.")

    # Display all words and meanings
    def display(self):
        print("\nDictionary Contents:")
        found = False

        for index in range(self.size):
            if self.table[index]:
                found = True
                print("Bucket", index, ":", end=" ")

                for entry in self.table[index]:
                    print(entry[0], "-", entry[1], end=" | ")

                print()

        if not found:
            print("Dictionary is empty.")


# Main program
dictionary = DictionaryHashTable()

while True:
    print("\n===== DICTIONARY APPLICATION =====")
    print("1. Add Word")
    print("2. Search Word")
    print("3. Delete Word")
    print("4. Display Dictionary")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        word = input("Enter word: ").strip()
        meaning = input("Enter meaning: ").strip()

        if word and meaning:
            dictionary.add_word(word, meaning)
        else:
            print("Word and meaning cannot be empty.")

    elif choice == "2":
        word = input("Enter word to search: ").strip()
        if word:
            dictionary.search_word(word)
        else:
            print("Please enter a word.")

    elif choice == "3":
        word = input("Enter word to delete: ").strip()
        if word:
            dictionary.delete_word(word)
        else:
            print("Please enter a word.")

    elif choice == "4":
        dictionary.display()

    elif choice == "5":
        print("Exiting Dictionary Application.")
        break

    else:
        print("Invalid choice. Please try again.")
